{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "sc: regen status",
            "detail": "sc-regen --dry-run: which installed build is newest and whether a datacore tag or regen PR already covers it. Regens and releases themselves are automatic (sc-regen task + release.yml).",
            "type": "shell",
            "command": "sc-regen",
            "args": [
                "--repo",
                "${workspaceFolder}",
                "--dry-run"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "sc: generate --check",
            "detail": "Parse the P4K and validate the generator without writing files. Auto-discovers LIVE P4K.",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run",
                "-p",
                "sc-generator",
                "--release",
                "--",
                "--check"
            ],
            "group": "test",
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}
